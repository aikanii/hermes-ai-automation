+const apiProxy = {
+  target: process.env.HERMES_API_PROXY ?? "http://127.0.0.1:3000",
+  changeOrigin: true,
+};
+
+export default defineConfig({
+  plugins: [react()],
+  server: {
+    host: "0.0.0.0",
+    port: 5173,
+    strictPort: true,
+    allowedHosts: true,
+    proxy: {
+      "/health": apiProxy,
+      "/nodes": apiProxy,
+      "/workflows": apiProxy,
+    },
+  },
+  preview: {
+    host: "0.0.0.0",
+    port: 5173,
+    allowedHosts: true,
+    proxy: {
+      "/health": apiProxy,
+      "/nodes": apiProxy,
+      "/workflows": apiProxy,
