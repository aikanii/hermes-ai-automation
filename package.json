{
  "name": "hermes",
  "version": "0.0.1",
  "private": true,
  "description": "Hermes - an open workflow automation engine (n8n-style)",
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r exec tsc --noEmit",
    "test": "corepack pnpm --filter @hermes/api test",
    "dev:api": "corepack pnpm --filter @hermes/api dev",
    "dev:web": "corepack pnpm --filter @hermes/web dev",
    "demo": "corepack pnpm --filter @hermes/api demo"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "isolated-vm"
    ]
  }
}